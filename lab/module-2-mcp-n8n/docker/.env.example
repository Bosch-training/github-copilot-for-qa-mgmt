# Copy this file to .env and fill in real values before running
# docker compose up -d
#
# Never commit the real .env file — it holds your n8n encryption key.
#
# Note: there's no login credential to set here. n8n shows its own
# "create owner account" screen (email + password) the first time you open
# http://localhost:5678 — that's your real login, stored in n8n's own local
# database. Older N8N_BASIC_AUTH_* env vars are no longer functional in
# current n8n and are intentionally not used here.

# Encrypts stored credentials (Jira, SMTP, AI provider) inside n8n's local
# database. Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-random-32-plus-char-string

# Adjust to your training location; used for the Schedule Trigger node's timing.
GENERIC_TIMEZONE=Asia/Kolkata

# Splunk demo only (splunk-demo.md) — not used by n8n or any lab exercise.
# Splunk's own password rule: 8+ characters, at least one uppercase letter
# and one digit. Login is "admin" + this password at http://localhost:8000.
SPLUNK_PASSWORD=Replace-With-A-Real-Password1
